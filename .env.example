# Names only. Real values live in Vercel (Settings → Environment Variables) and in .env.local,
# which git ignores. Never commit a value.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only.
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=

# Mercado Pago
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Server only.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Test mode only; leave unset in production.
MERCADOPAGO_TEST_PAYER_EMAIL=

# WhatsApp (Meta WhatsApp Business Platform, Cloud API). All server only.
# Meta app → App settings → Basic.
META_APP_ID=
META_APP_SECRET=
# Any long random text; the same value goes in Meta app → WhatsApp → Configuration → Verify token.
WHATSAPP_VERIFY_TOKEN=
# Optional; defaults to v25.0.
WHATSAPP_GRAPH_VERSION=
# Test phase: Meta's test number, usable only by the clinic whose owner signs in with this e-mail.
WHATSAPP_TEST_ACCESS_TOKEN=
WHATSAPP_TEST_PHONE_NUMBER_ID=
WHATSAPP_TEST_OWNER_EMAIL=
# Later: Meta's Embedded Signup (clinics connect their own number). Leave unset until then.
META_EMBEDDED_SIGNUP_CONFIG_ID=
