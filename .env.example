# Names only. Real values live in Vercel (Settings → Environment Variables) and in .env.local,
# which git ignores. Never commit a value.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only.
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=

# Mercado Pago
# Billing, for the Pulse and for the maintenance subscriptions alike, is decided
# in one place (src/lib/maintenance/environment.ts). A test account's Access
# Token ALSO starts with APP_USR-, so the key cannot tell the environments
# apart: the environment is declared in MERCADOPAGO_ENV and checked against
# where the code runs (VERCEL_ENV). When anything does not add up, billing closes.
#
# The card form's key (public, goes to the browser). A TEST- key closes the
# Pulse checkout whenever the environment is a real one. Maintenance does not
# use it. Any other key proves nothing and changes nothing.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Server only.
MERCADOPAGO_ACCESS_TOKEN=
# Without it the Pulse webhook refuses every notice (401, and logs that the
# secret is missing), so status changes and monthly charges never arrive. The
# maintenance webhook refuses the notices that carry a signature.
MERCADOPAGO_WEBHOOK_SECRET=
# Test mode only: the test buyer's e-mail, required when MERCADOPAGO_ENV=test.
# Ignored in production, even if left set.
MERCADOPAGO_TEST_PAYER_EMAIL=
# Which Mercado Pago account is in use. Read without case or surrounding spaces.
#   empty or "live"  real credentials. Allowed only on Vercel Production
#                    (VERCEL_ENV=production); anywhere else billing is closed.
#   "test"           a test account. Allowed only outside Production, and only
#                    with MERCADOPAGO_TEST_PAYER_EMAIL set. On Production it
#                    closes billing.
#   anything else    ("sandbox", "production", a typo...) closes billing.
# So outside Production billing stays closed by default: it opens only with
# MERCADOPAGO_ENV=test, the test credentials and the test buyer. Never set it
# to "test" on Vercel Production, where the real credentials live.
MERCADOPAGO_ENV=

# Maintenance subscriptions (/manutencao). Server only: who may open the panel.
# The e-mails of existing Supabase accounts, separated by commas. Unset: nobody.
WUAVY_ADMIN_EMAILS=

# WhatsApp (Meta WhatsApp Business Platform, Cloud API). All server only.
# Meta app → App settings → Basic.
META_APP_ID=
META_APP_SECRET=
# Any long random text; the same value goes in Meta app → WhatsApp → Configuration → Verify token.
WHATSAPP_VERIFY_TOKEN=
# Optional; defaults to v25.0.
WHATSAPP_GRAPH_VERSION=
# Test phase: Meta's test number, usable only by the clinic whose owner signs in with this e-mail.
WHATSAPP_TEST_ACCESS_TOKEN=
WHATSAPP_TEST_PHONE_NUMBER_ID=
WHATSAPP_TEST_OWNER_EMAIL=
# Later: Meta's Embedded Signup (clinics connect their own number). Leave unset until then.
META_EMBEDDED_SIGNUP_CONFIG_ID=
